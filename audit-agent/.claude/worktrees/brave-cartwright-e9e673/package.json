{
  "name": "audit-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dashboard": "node --env-file-if-exists=.env --experimental-strip-types src/dashboard/server.ts",
    "audit-site": "node --env-file-if-exists=.env --experimental-strip-types src/cli/index.ts audit-site",
    "audit-page": "node --env-file-if-exists=.env --experimental-strip-types src/cli/index.ts audit-page",
    "agent": "node --env-file-if-exists=.env --experimental-strip-types src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@fastify/static": "8.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "better-sqlite3": "12.11.1",
    "canonicalize": "5.0.0",
    "commander": "15.0.0",
    "culori": "4.0.2",
    "exceljs": "4.4.0",
    "fastify": "5.7.1",
    "p-queue": "9.3.3",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "ts-morph": "28.0.0",
    "yazl": "^3.3.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/culori": "4.0.1",
    "@types/node": "24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/yazl": "^3.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
